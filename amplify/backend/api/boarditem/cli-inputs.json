{
  "version": 1,
  "paths": {
    "/boarditem/increment-views/{id}": {
      "name": "/boarditem/increment-views/{id}",
      "lambdaFunction": "IncrementBoardItemViews",
      "permissions": {
        "setting": "open"
      }
    },
    "/boarditem/get/{boardTitle}/{boarditemSeq}": {
      "name": "/boarditem/get/{boardTitle}/{boarditemSeq}",
      "lambdaFunction": "getBoardItembyBoardTitleAndBoardItemSeq",
      "permissions": {
        "setting": "open"
      }
    },
    "/boarditem/delete/{id}": {
      "name": "/boarditem/delete/{id}",
      "lambdaFunction": "deleteBoardItem",
      "permissions": {
        "setting": "open"
      }
    }
  }
}